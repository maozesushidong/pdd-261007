{
	auto_https disable_redirects
	default_sni 121.196.220.219
}

(security_headers) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
		Referrer-Policy "no-referrer"
	}
}

(public_gateway) {
	import security_headers

        @douyinRoot path /douyin
        redir @douyinRoot /douyin/ 308

        handle_path /douyin/* {
                reverse_proxy 127.0.0.1:8787
        }

        @douyinApi path /api/health /api/overview /api/workflows
        handle @douyinApi {
                reverse_proxy 127.0.0.1:8787
        }

        @douyinDetail path /detail/*
        handle @douyinDetail {
                reverse_proxy 127.0.0.1:8787
        }

        @douyinAssets path /assets/*
        handle @douyinAssets {
                reverse_proxy 127.0.0.1:8787
        }

	handle_path /public-api/* {
		reverse_proxy 127.0.0.1:80
	}

	handle_path /public/* {
		reverse_proxy 127.0.0.1:80
	}

	@publicAssets path_regexp publicAssets ^/assets/public-[^/]+$
	handle @publicAssets {
		reverse_proxy 127.0.0.1:80
	}

	handle / {
		redir * /public/ 302
	}

	handle {
		respond 404
	}
}

(owner_gateway) {
	import security_headers

	@ownerAuth path /api/v1/auth/login /api/v1/auth/logout /api/v1/auth/me
	handle @ownerAuth {
		reverse_proxy 127.0.0.1:4173 {
			header_up -Origin
		}
	}

	@ownerProtected path /api/* /remote-desktop /remote-desktop/*
	handle @ownerProtected {
		forward_auth 127.0.0.1:3000 {
			uri /api/v1/auth/authorize
			header_up -Origin
		}
		reverse_proxy 127.0.0.1:4173 {
			header_up -Origin
		}
	}

	handle_path /owner/* {
		reverse_proxy 127.0.0.1:4173 {
			header_up -Origin
		}
	}

	handle / {
		redir * /owner/?owner=login 302
	}

	handle {
		reverse_proxy 127.0.0.1:4173 {
			header_up -Origin
		}
	}
}

https://121.196.220.219 {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			profile shortlived
		}
	}
	import public_gateway
}

https://121.196.220.219:10443 {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			profile shortlived
		}
	}
	import owner_gateway
}


